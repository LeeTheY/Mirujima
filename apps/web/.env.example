NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Defaults to test; live requires matching keys and a separately enabled server gate.
NEXT_PUBLIC_TOSS_PAYMENT_MODE=test
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Chrome extensions page: local development ID differs from the published extension ID
NEXT_PUBLIC_MIRUJIMA_EXTENSION_ID=

# Supabase VAPID_PUBLIC_KEY와 동일한 공개키. private key는 Supabase Secret 전용.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
