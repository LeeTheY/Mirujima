{
  "name": "mirujima",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "overrides": {
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "nanoid": "3.3.17"
  },
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "security:scan-public": "node --env-file-if-exists=apps/web/.env.local scripts/check-public-secrets.mjs",
    "test": "vitest run",
    "test:e2e:web": "npm run test:e2e --workspace @mirujima/web",
    "verify:release": "npm run verify:local && npm run test:db && npm run verify:browsers && npm run test:e2e:release:web && npm run verify:release:evidence",
    "test:watch": "vitest",
    "test:e2e:release:web": "MIRUJIMA_E2E_REQUIRED=1 npm run test:e2e:web",
    "test:extension:smoke": "node scripts/test-extension-smoke.mjs",
    "verify:local": "npm test && npm run lint && npm run typecheck && npm run build && npm run typecheck --workspace @mirujima/web && npm run lint --workspace @mirujima/web && npm run build --workspace @mirujima/web && npm run security:scan-public",
    "test:db": "supabase test db",
    "operations:check": "node scripts/check-operations.mjs",
    "release:preflight": "node --env-file=.env.local --env-file=apps/web/.env.local scripts/check-deployment-config.mjs",
    "test:db:restore": "node scripts/rehearse-db-restore.mjs",
    "test:e2e:public:web": "npm run test:e2e --workspace @mirujima/web -- --project=unauthenticated-chromium",
    "verify:release:evidence": "node scripts/check-release-evidence.mjs",
    "test:web:dialog": "node scripts/test-web-dialog-smoke.mjs",
    "test:web:pwa": "node scripts/test-web-pwa-smoke.mjs",
    "verify:browsers": "npm run test:web:dialog && npm run test:web:pwa && npm run build:dev && npm run test:extension:smoke && npm run build && npm run security:scan-public"
  },
  "dependencies": {
    "@mirujima/contracts": "*",
    "@supabase/supabase-js": "^2.110.6",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/chrome": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "supabase": "^2.113.0",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
